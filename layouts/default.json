        { "key": "sep", "text": "|" },
        { "key": "emoji", "text": "🌿" },
        { "key": "branch", "text": "main", "style": ["m"] },
        { "key": "git.mark", "text": "👍" },
        { "key": "diff.add", "text": "+75", "style": ["g"] },
        { "key": "diff.del", "text": "−8", "style": ["r"] }
