      "elements": [
        { "key": "emoji", "text": "💬" },
        { "key": "session.name", "text": "Fix the login timeout" },
        { "key": "sep", "text": "|" },
        { "key": "cache", "text": "⚡ cache warm 97% hit, cold in 19m" },
        { "key": "sep", "text": "|" },
        { "key": "emoji", "text": "🔗" },
        { "key": "repo", "text": "acme/shop", "style": ["u"] },
        { "key": "sep", "text": "|" },
